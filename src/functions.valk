/// Get current music time played (in seconds).
+ fn get_music_time_played(music: Music) f32 {
    return GetMusicTimePlayed(music)
}
/// Load audio stream (to stream raw audio pcm data).
+ fn load_audio_stream(sample_rate: u32, sample_size: u32, channels: u32) AudioStream {
    return LoadAudioStream(sample_rate, sample_size, channels)
}
/// Checks if an audio stream is valid (buffers initialized).
+ fn is_audio_stream_valid(stream: AudioStream) bool {
    return IsAudioStreamValid(stream)
}
/// Unload audio stream and free memory.
+ fn unload_audio_stream(stream: AudioStream) {
    UnloadAudioStream(stream)
}
/// Check if any audio stream buffers requires refill.
+ fn is_audio_stream_processed(stream: AudioStream) bool {
    return IsAudioStreamProcessed(stream)
}
/// Play audio stream.
+ fn play_audio_stream(stream: AudioStream) {
    PlayAudioStream(stream)
}
/// Pause audio stream.
+ fn pause_audio_stream(stream: AudioStream) {
    PauseAudioStream(stream)
}
/// Resume audio stream.
+ fn resume_audio_stream(stream: AudioStream) {
    ResumeAudioStream(stream)
}
/// Check if audio stream is playing.
+ fn is_audio_stream_playing(stream: AudioStream) bool {
    return IsAudioStreamPlaying(stream)
}
/// Stop audio stream.
+ fn stop_audio_stream(stream: AudioStream) {
    StopAudioStream(stream)
}
/// Set volume for audio stream (1.0 is max level).
+ fn set_audio_stream_volume(stream: AudioStream, volume: f32) {
    SetAudioStreamVolume(stream, volume)
}
/// Set pitch for audio stream (1.0 is base level).
+ fn set_audio_stream_pitch(stream: AudioStream, pitch: f32) {
    SetAudioStreamPitch(stream, pitch)
}
/// Set pan for audio stream (-1.0 to 1.0 range, 0.0 is centered).
+ fn set_audio_stream_pan(stream: AudioStream, pan: f32) {
    SetAudioStreamPan(stream, pan)
}
/// Default size for new audio streams.
+ fn set_audio_stream_buffer_size_default(size: i32) {
    SetAudioStreamBufferSizeDefault(size)
}
